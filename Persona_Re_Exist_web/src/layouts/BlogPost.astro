---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'chapters'>['data'] & { 
	id: string;
	prev: CollectionEntry<'chapters'> | null;
	next: CollectionEntry<'chapters'> | null;
};

const { title, description, pubDate, updatedDate, heroImage, volume, chapterNumber, id, prev, next, draft } = Astro.props;

const allChapters = await getCollection('chapters');
allChapters.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			/* Prevent Horizontal Scrolling without breaking sticky */
			body {
				max-width: 100%;
			}
			*, *::before, *::after {
				box-sizing: border-box;
			}
			
			/* NavBar Styles - Adaptive Theme */
			.reader-nav {
				position: sticky;
				top: 0;
				width: 100%;
				background: var(--bg-sepia);
				border-bottom: 1px solid rgba(217, 101, 139, 0.2);
				z-index: 100;
				display: flex;
				justify-content: center;
				padding: 0.35rem 1rem;
				box-shadow: var(--box-shadow);
				transition: background 0.3s, border-color 0.3s;
			}
			.nav-container {
				display: flex;
				gap: 1.5rem;
				align-items: center;
			}
			.icon-btn {
				background: transparent;
				border: none;
				color: var(--gray-dark);
				cursor: pointer;
				padding: 0.4rem;
				border-radius: 8px;
				transition: color 0.2s, background 0.2s;
				display: flex;
				align-items: center;
				justify-content: center;
				text-decoration: none;
			}
			.icon-btn:hover {
				color: var(--accent);
				background: var(--gray-light);
			}
			.icon-btn svg {
				width: 20px;
				height: 20px;
			}
			.btn-contents {
				background: transparent;
				border: 1px solid var(--gray);
				color: var(--black);
				cursor: pointer;
				padding: 0.35rem 1rem;
				border-radius: 8px;
				transition: all 0.2s;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-family: var(--font-ui);
				font-weight: 500;
				font-size: 0.9em;
				text-decoration: none;
			}
			.btn-contents:hover {
				border-color: var(--accent);
				color: var(--accent);
				background: var(--gray-light);
			}
			.btn-contents svg {
				width: 16px;
				height: 16px;
			}
			
			/* Article Styles */
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 800px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
				color: var(--black);
			}
			.title {
				margin-bottom: 2em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
				font-family: var(--font-ui);
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--gray);
				font-size: 0.85em;
			}
			.draft-badge {
				display: inline-block;
				margin-left: 0.75rem;
				padding: 0.25rem 0.75rem;
				background: rgba(217, 119, 6, 0.1);
				color: #d97706;
				border: 1px solid rgba(217, 119, 6, 0.3);
				border-radius: 20px;
				font-size: 0.4em;
				text-transform: uppercase;
				font-family: monospace;
				font-weight: bold;
				letter-spacing: 0.05em;
				vertical-align: middle;
			}
			
			/* Chapter Navigation */
			.chapter-nav {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-top: 4rem;
				gap: 1rem;
				border-top: 1px dashed rgba(217, 101, 139, 0.3);
				padding-top: 2rem;
			}
			.nav-btn {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				text-decoration: none;
				color: var(--black);
				background: var(--gray-light);
				padding: 1rem;
				border-radius: 8px;
				border: 1px solid var(--gray);
				transition: all 0.2s;
				flex: 1;
				min-width: 0;
			}
			.nav-btn:hover:not(.empty) {
				border-color: var(--accent);
				box-shadow: var(--box-shadow);
				transform: translateY(-2px);
			}
			.nav-btn.empty {
				background: transparent;
				border: none;
				visibility: hidden;
			}
			.nav-btn-content {
				display: flex;
				flex-direction: column;
				min-width: 0;
			}
			.nav-btn-content span {
				font-size: 0.75em;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: var(--gray-dark);
			}
			.nav-btn-content strong {
				font-size: 0.95em;
				color: var(--accent);
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.center-btn {
				flex: 0 0 auto;
				padding: 1rem;
				border-radius: 50%;
				justify-content: center;
			}
			.center-btn svg {
				width: 24px;
				height: 24px;
				color: var(--accent);
			}
			.prev-btn svg, .next-btn svg {
				width: 20px;
				height: 20px;
				color: var(--accent);
				flex-shrink: 0;
			}
			.next-btn {
				text-align: right;
				flex-direction: row;
			}
			@media (max-width: 600px) {
				.chapter-nav {
					flex-direction: column;
					align-items: stretch;
				}
				.center-btn {
					border-radius: 8px;
					order: -1;
					margin-bottom: 0.5rem;
				}
			}
			
			/* Restore Nav Button */
			.restore-nav-btn {
				position: fixed;
				top: 1.5rem;
				right: 1.5rem;
				z-index: 99;
				background: var(--accent);
				border: 2px solid rgba(255, 255, 255, 0.2);
				color: var(--bg-sepia);
				width: 48px;
				height: 48px;
				border-radius: 50%;
				cursor: pointer;
				box-shadow: 0 4px 15px rgba(217, 101, 139, 0.4);
				display: none;
				align-items: center;
				justify-content: center;
				transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
				opacity: 0.9;
				animation: gentlePulse 3s infinite;
			}
			@keyframes gentlePulse {
				0% { box-shadow: 0 0 0 0 rgba(217, 101, 139, 0.4); }
				70% { box-shadow: 0 0 0 10px rgba(217, 101, 139, 0); }
				100% { box-shadow: 0 0 0 0 rgba(217, 101, 139, 0); }
			}
			.restore-nav-btn:hover {
				opacity: 1;
				transform: scale(1.1);
				box-shadow: 0 6px 20px rgba(217, 101, 139, 0.6);
			}
			.restore-nav-btn svg {
				width: 24px;
				height: 24px;
			}
			
			/* Settings Modal - Adaptive Theme */
			.settings-modal {
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: rgba(0,0,0,0.6);
				z-index: 1000;
				display: none;
				align-items: center;
				justify-content: center;
				backdrop-filter: blur(2px);
			}
			.settings-modal.show {
				display: flex;
			}
			.settings-content {
				background: var(--bg-sepia);
				border: 1px solid var(--accent);
				border-radius: 12px;
				width: 90%;
				max-width: 580px;
				box-shadow: var(--box-shadow);
				font-family: var(--font-ui);
				overflow: hidden;
				color: var(--black);
				animation: slideIn 0.2s ease-out;
			}
			@keyframes slideIn {
				from { transform: translateY(20px); opacity: 0; }
				to { transform: translateY(0); opacity: 1; }
			}
			.settings-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 1rem 1.5rem;
				border-bottom: 1px solid rgba(217, 101, 139, 0.2);
			}
			.settings-header h3 {
				margin: 0;
				display: flex;
				align-items: center;
				gap: 0.5rem;
				color: var(--accent);
				font-size: 1rem;
				font-weight: 700;
				letter-spacing: 0.05em;
			}
			.settings-header h3 svg {
				width: 18px;
				height: 18px;
			}
			.settings-actions {
				display: flex;
				gap: 1rem;
				align-items: center;
			}
			.reset-btn {
				background: none;
				border: none;
				color: var(--gray-dark);
				font-weight: 600;
				font-size: 0.8em;
				cursor: pointer;
				font-family: inherit;
				transition: color 0.2s;
			}
			.reset-btn:hover {
				color: var(--accent);
			}
			.close-btn {
				background: none;
				border: none;
				color: var(--gray-dark);
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				transition: color 0.2s;
				padding: 0;
			}
			.close-btn:hover {
				color: var(--accent);
			}
			
			.settings-grid {
				display: grid;
				grid-template-columns: 1fr;
				gap: 1.5rem;
				padding: 1.25rem 1.5rem;
				max-height: 75vh;
				overflow-y: auto;
			}
			@media (min-width: 600px) {
				.settings-grid {
					grid-template-columns: 1fr 1fr;
				}
			}
			.settings-group-title {
				font-size: 0.75em;
				letter-spacing: 0.15em;
				text-transform: uppercase;
				color: var(--gray);
				margin: 0 0 1rem 0;
				font-weight: 700;
				border-bottom: 1px dashed rgba(217, 101, 139, 0.2);
				padding-bottom: 0.25rem;
			}
			.setting-item {
				margin-bottom: 1.25rem;
			}
			.setting-item label {
				display: block;
				color: var(--gray-dark);
				margin-bottom: 0.4rem;
				font-size: 0.85em;
				font-weight: 600;
			}
			.setting-item select {
				width: 100%;
				padding: 0.4rem 0.5rem;
				border-radius: 6px;
				border: 1px solid var(--gray);
				background: var(--gray-light);
				color: var(--black);
				font-family: inherit;
				font-size: 0.85em;
				cursor: pointer;
				outline: none;
				transition: border-color 0.2s;
			}
			.setting-item select:focus {
				border-color: var(--accent);
			}
			.slider-row {
				display: flex;
				gap: 1.5rem;
				width: 100%;
			}
			.flex-half {
				flex: 1;
				min-width: 0;
			}
			.slider-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 0.4rem;
			}
			.slider-header span {
				font-size: 0.75em;
				color: var(--gray);
			}
			/* Custom Range Sliders */
			input[type="range"] {
				-webkit-appearance: none;
				width: 100%;
				height: 8px;
				background: var(--gray-light);
				border: 1px solid rgba(217, 101, 139, 0.2);
				border-radius: 4px;
				outline: none;
			}
			input[type="range"]::-webkit-slider-thumb {
				-webkit-appearance: none;
				appearance: none;
				width: 18px;
				height: 18px;
				border-radius: 50%;
				background: var(--bg-sepia);
				cursor: pointer;
				border: 3px solid var(--accent);
			}
			
			/* Contribute Modal Specifics */
			.contribute-content {
				max-width: 450px;
				padding: 2.5rem 2rem;
				position: relative;
				text-align: center;
			}
			.contribute-header {
				margin-bottom: 2rem;
			}
			.contribute-header h3 {
				color: var(--accent);
				font-family: var(--font-ui);
				font-size: 1.1em;
				letter-spacing: 0.15em;
				text-transform: uppercase;
				margin: 0;
			}
			.contribute-hr {
				width: 60px;
				border: 0;
				border-top: 2px solid var(--accent);
				margin: 0.75rem auto 0;
				opacity: 0.5;
			}
			.contribute-btn {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.75rem;
				width: 100%;
				padding: 0.8rem;
				border-radius: 6px;
				text-decoration: none;
				font-family: var(--font-ui);
				font-weight: 600;
				font-size: 0.95em;
				margin-bottom: 1rem;
				transition: opacity 0.2s, transform 0.2s;
			}
			.contribute-btn:hover {
				opacity: 0.9;
				transform: translateY(-2px);
			}
			.contribute-btn svg {
				width: 18px;
				height: 18px;
			}
			.guide-btn {
				background: rgba(217, 101, 139, 0.1);
				border: 1px solid rgba(217, 101, 139, 0.3);
				color: var(--accent);
			}
			.github-btn {
				background: #a3e6b5;
				border: none;
				color: #1a4f2d;
			}
			
			/* TOC Modal Specifics */
			.toc-content {
				max-width: 600px;
				width: 90%;
				padding: 2rem 2.5rem;
				position: relative;
				height: 80vh;
				display: flex;
				flex-direction: column;
			}
			.toc-header {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				margin-bottom: 1.5rem;
			}
			.toc-title-wrapper {
				display: flex;
				flex-direction: column;
			}
			.toc-title-wrapper h3 {
				color: var(--accent);
				font-family: var(--font-ui);
				font-size: 1.1em;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				margin: 0 0 0.5rem 0;
			}
			.toc-hr {
				width: 30px;
				border: 0;
				border-top: 2px solid var(--accent);
				opacity: 0.5;
				margin: 0;
			}
			.toc-close-btn {
				background: transparent;
				border: 1px solid var(--black);
				color: var(--black);
				border-radius: 50%;
				width: 32px;
				height: 32px;
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				transition: all 0.2s;
			}
			.toc-close-btn:hover {
				background: rgba(0,0,0,0.05);
				transform: scale(1.05);
			}
			.toc-filters {
				display: flex;
				gap: 0.75rem;
				margin-bottom: 1.5rem;
			}
			.toc-search {
				flex: 1;
				background: transparent;
				border: 1px solid var(--gray);
				border-radius: 4px;
				padding: 0.5rem 0.75rem;
				font-family: var(--font-ui);
				color: var(--black);
				outline: none;
				font-size: 0.85em;
			}
			.toc-search:focus {
				border-color: var(--accent);
			}
			.toc-sort-btn {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 42px;
				flex-shrink: 0;
				background: transparent;
				color: var(--black);
				border: 1px solid var(--gray);
				border-radius: 4px;
				cursor: pointer;
				transition: all 0.2s;
			}
			.toc-sort-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.toc-sort-icon {
				width: 20px;
				height: 20px;
				transition: transform 0.3s;
			}
			.toc-list {
				flex: 1;
				overflow-y: auto;
				display: flex;
				flex-direction: column;
				gap: 0;
				padding-right: 0.5rem;
				margin: 0 -1rem;
				padding: 0 1rem;
			}
			.toc-list::-webkit-scrollbar {
				width: 6px;
			}
			.toc-list::-webkit-scrollbar-track {
				background: transparent;
			}
			.toc-list::-webkit-scrollbar-thumb {
				background: rgba(0,0,0,0.15);
				border-radius: 4px;
			}
			.toc-item {
				display: flex;
				align-items: center;
				gap: 2rem;
				padding: 0.75rem 1rem;
				text-decoration: none;
				color: var(--black);
				transition: all 0.15s;
				font-family: var(--font-ui);
				font-size: 0.85em;
				border-radius: 4px;
			}
			.toc-item:hover {
				background: rgba(0,0,0,0.03);
			}
			.toc-item.active {
				background: rgba(217, 101, 139, 0.05);
				color: var(--accent);
			}
			.toc-num {
				opacity: 0.5;
				min-width: 2rem;
				font-size: 0.85em;
			}
			.toc-title {
				font-weight: 500;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			
			/* Toggles */
			.toggle-item {
				display: flex;
				align-items: center;
				gap: 1rem;
				margin-bottom: 1rem;
			}
			.toggle-item span {
				color: var(--gray-dark);
				font-size: 0.95em;
				font-weight: 500;
			}
			.switch {
				position: relative;
				display: inline-block;
				width: 44px;
				height: 24px;
			}
			.switch input {
				opacity: 0;
				width: 0;
				height: 0;
			}
			.slider {
				position: absolute;
				cursor: pointer;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				background-color: var(--gray);
				transition: .4s;
				border-radius: 24px;
			}
			.slider:before {
				position: absolute;
				content: "";
				height: 18px;
				width: 18px;
				left: 3px;
				bottom: 3px;
				background-color: var(--bg-sepia);
				transition: .4s;
				border-radius: 50%;
			}
			input:checked + .slider {
				background-color: var(--accent);
			}
			input:checked + .slider:before {
				transform: translateX(20px);
			}
			
			/* Alignment Group */
			.align-group {
				display: flex;
				background: var(--gray-light);
				border-radius: 8px;
				overflow: hidden;
				border: 1px solid var(--gray);
				margin-bottom: 1.5rem;
			}
			.align-btn {
				flex: 1;
				background: transparent;
				border: none;
				padding: 0.5rem;
				cursor: pointer;
				color: var(--gray-dark);
				transition: all 0.2s;
				display: flex;
				justify-content: center;
			}
			.align-btn:not(:last-child) {
				border-right: 1px solid var(--gray);
			}
			.align-btn:hover {
				background: rgba(217, 101, 139, 0.1);
			}
			.align-btn.active {
				background: var(--accent);
				color: var(--bg-sepia);
			}
			.align-btn svg {
				width: 18px;
				height: 18px;
			}
			
			/* Fullscreen Button */
			.fullscreen-btn {
				width: 100%;
				background: transparent;
				border: 1px solid var(--accent);
				color: var(--accent);
				padding: 0.75rem;
				border-radius: 8px;
				font-family: var(--font-ui);
				font-size: 0.95em;
				font-weight: 600;
				cursor: pointer;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.5rem;
				transition: all 0.2s;
			}
			.fullscreen-btn:hover {
				background: var(--accent);
				color: var(--bg-sepia);
			}
			.fullscreen-btn svg {
				width: 18px;
				height: 18px;
			}
			
			/* Mobile Optimization */
			@media (max-width: 720px) {
				.prose {
					max-width: 100%;
					padding: 1.5em 0; /* Let main handle the horizontal padding */
				}
				.title {
					padding-top: 0;
				}
				.chapter-nav {
					flex-direction: column;
					gap: 1.5rem;
				}
				.nav-btn {
					width: 100%;
				}
				.center-btn {
					order: -1;
					margin-bottom: 0.5rem;
				}
				.nav-container {
					gap: 0.75rem;
					padding: 0.35rem 0.5rem;
				}
				.btn-contents span {
					display: none;
				}
				#comments-section {
					padding: 1rem !important;
				}
			}
		</style>
	</head>

	<body>
		<nav class="reader-nav">
			<div class="nav-container">
				<a href="/" title="Home" class="icon-btn">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
				</a>
				<a href="#comments-section" title="Comments" class="icon-btn">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
				</a>
				<button title="Contents" class="btn-contents btn-toc">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
					<span>Contents</span>
				</button>
				<button id="btn-contribute" title="Contribute" class="icon-btn">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path></svg>
				</button>
				<button id="reader-settings-btn" title="Settings" class="icon-btn">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
				</button>
			</div>
		</nav>
		
		<button id="btn-restore-nav" class="restore-nav-btn" title="Show Navbar">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
		</button>

		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose" id="reader-prose">
					<div class="title">
						<div class="date">
							{pubDate && <FormattedDate date={pubDate} />}
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						{volume && chapterNumber && <p style="margin:0; opacity: 0.7;">Volume {volume} - Chapter {chapterNumber}</p>}
						<h1>
							{title}
							{draft && (
								<span class="draft-badge">
									{typeof draft === 'string' ? draft : 'Draft'}
								</span>
							)}
						</h1>
						<hr />
					</div>
					<slot />
					
					<!-- Chapter Navigation -->
					<div class="chapter-nav">
						{prev ? (
							<a href={`/chapters/${prev.id}/`} class="nav-btn prev-btn">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
								<div class="nav-btn-content" style="align-items: flex-start;">
									<span>Previous</span>
									<strong>{prev.data.title}</strong>
								</div>
							</a>
						) : (
							<div class="nav-btn empty"></div>
						)}
						
						<button class="nav-btn center-btn btn-toc" title="Table of Contents">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
						</button>

						{next ? (
							<a href={`/chapters/${next.id}/`} class="nav-btn next-btn">
								<div class="nav-btn-content" style="align-items: flex-end;">
									<span>Next</span>
									<strong>{next.data.title}</strong>
								</div>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
							</a>

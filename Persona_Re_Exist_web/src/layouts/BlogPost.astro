							<a href={`/chapters/${ch.id}/`} class={`toc-item ${ch.id === id ? 'active' : ''}`} data-title={ch.data.title.toLowerCase()}>
								<span class="toc-num">#{index + 1}</span>
								<span class="toc-title">{ch.data.title}</span>
							</a>
						))}

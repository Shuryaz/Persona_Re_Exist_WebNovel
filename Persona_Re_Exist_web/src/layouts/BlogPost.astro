			</div>

		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const modal = document.getElementById('reader-settings-modal');
				const btnOpen = document.getElementById('reader-settings-btn');
				const btnClose = document.getElementById('settings-close');
				const btnReset = document.getElementById('settings-reset');
				const prose = document.getElementById('reader-prose');

				// Controls
				const ctrlTheme = document.getElementById('ctrl-theme');
				const ctrlFont = document.getElementById('ctrl-font');
				const ctrlSize = document.getElementById('ctrl-size') as HTMLInputElement;
				const ctrlHeight = document.getElementById('ctrl-height') as HTMLInputElement;
				const ctrlWeight = document.getElementById('ctrl-weight') as HTMLInputElement;
				
				const ctrlSolidBg = document.getElementById('ctrl-solid-bg') as HTMLInputElement;
				const ctrlIndent = document.getElementById('ctrl-indent') as HTMLInputElement;
				const ctrlHyphen = document.getElementById('ctrl-hyphen') as HTMLInputElement;
				
				const ctrlStickyNav = document.getElementById('ctrl-sticky-nav') as HTMLInputElement;
				const ctrlShowNav = document.getElementById('ctrl-show-nav') as HTMLInputElement;
				const ctrlInfoBanner = document.getElementById('ctrl-info-banner') as HTMLInputElement;
				const ctrlShowComments = document.getElementById('ctrl-show-comments') as HTMLInputElement;
				
				const btnFullscreen = document.getElementById('ctrl-fullscreen');
				const btnRestoreNav = document.getElementById('btn-restore-nav');
				const alignBtns = document.querySelectorAll('.align-btn');
				const navBar = document.querySelector('.reader-nav') as HTMLElement;

				// Labels
				const lblSize = document.getElementById('lbl-size');
				const lblHeight = document.getElementById('lbl-height');
				const lblWeight = document.getElementById('lbl-weight');

				// Default values
				const defaults = {
					theme: 'light',
					font: 'var(--font-novel)',
					size: '21',
					height: '1.9',
					weight: '400',
					solidBg: 'false',
					indent: 'true',
					hyphen: 'false',
					align: 'left',
					stickyNav: 'true',
					showNav: 'true',
					infoBanner: 'true',
					showComments: 'true'
				};

				// Load settings from localStorage
				const loadSettings = () => {
					ctrlTheme.value = localStorage.getItem('theme') || defaults.theme;
					ctrlFont.value = localStorage.getItem('reader-font') || defaults.font;
					ctrlSize.value = localStorage.getItem('reader-size') || defaults.size;
					ctrlHeight.value = localStorage.getItem('reader-height') || defaults.height;
					ctrlWeight.value = localStorage.getItem('reader-weight') || defaults.weight;
					
					ctrlSolidBg.checked = (localStorage.getItem('reader-solid-bg') || defaults.solidBg) === 'true';
					ctrlIndent.checked = (localStorage.getItem('reader-indent') || defaults.indent) === 'true';
					ctrlHyphen.checked = (localStorage.getItem('reader-hyphen') || defaults.hyphen) === 'true';
					
					ctrlStickyNav.checked = (localStorage.getItem('reader-sticky-nav') || defaults.stickyNav) === 'true';
					ctrlShowNav.checked = (localStorage.getItem('reader-show-nav') || defaults.showNav) === 'true';
					ctrlInfoBanner.checked = (localStorage.getItem('reader-info-banner') || defaults.infoBanner) === 'true';
					ctrlShowComments.checked = (localStorage.getItem('reader-show-comments') || defaults.showComments) === 'true';
					
					const savedAlign = localStorage.getItem('reader-align') || defaults.align;
					alignBtns.forEach(btn => {
						if (btn.getAttribute('data-align') === savedAlign) {
							btn.classList.add('active');
						} else {
							btn.classList.remove('active');
						}
					});

					applySettings();
				};

				function setGiscusTheme(theme: string) {
					const iframe = document.querySelector('iframe.giscus-frame') as HTMLIFrameElement;
					if (!iframe || !iframe.contentWindow) return;
					iframe.contentWindow.postMessage(
						{ giscus: { setConfig: { theme } } },
						'https://giscus.app'
					);
				}

				const applySettings = () => {
					// Apply Theme globally
					if (ctrlTheme.value === 'dark') {
						document.documentElement.setAttribute('data-theme', 'dark');
						setGiscusTheme('transparent_dark');
					} else {
						document.documentElement.removeAttribute('data-theme');
						setGiscusTheme('light');
					}
					localStorage.setItem('theme', ctrlTheme.value);

					// Handle Solid Background
					if (ctrlSolidBg.checked) {
						document.body.style.backgroundImage = 'none';
						document.body.style.background = 'var(--bg-sepia)';
					} else {
						document.body.style.backgroundImage = 'var(--bg-gradient)';
					}

					// Apply Readability directly to the prose div
					if (prose) {
						prose.style.fontFamily = ctrlFont.value;
						prose.style.fontSize = `${ctrlSize.value}px`;
						prose.style.lineHeight = ctrlHeight.value;
						prose.style.fontWeight = ctrlWeight.value;
						
						const activeAlign = document.querySelector('.align-btn.active')?.getAttribute('data-align') || 'left';
						prose.style.textAlign = activeAlign;
						
						// Handle Indent by injecting a style block for the slot
						let proseStyle = document.getElementById('dynamic-prose-style');
						if (!proseStyle) {
							proseStyle = document.createElement('style');
							proseStyle.id = 'dynamic-prose-style';
							document.head.appendChild(proseStyle);
						}
						
						let customCss = `
							#reader-prose p {
								text-indent: ${ctrlIndent.checked ? '1.5em' : '0'};
								hyphens: ${ctrlHyphen.checked ? 'auto' : 'none'};
								-webkit-hyphens: ${ctrlHyphen.checked ? 'auto' : 'none'};
							}
						`;
						proseStyle.innerHTML = customCss;
					}
					
					// Interface Settings
					if (navBar && btnRestoreNav) {
						if (!ctrlShowNav.checked) {
							navBar.style.display = 'none';
							btnRestoreNav.style.display = 'flex';
						} else {
							navBar.style.display = 'flex';
							btnRestoreNav.style.display = 'none';
							if (ctrlStickyNav.checked) {
								navBar.style.position = 'sticky';
							} else {
								navBar.style.position = 'relative';
							}
						}
					}
					
					const banner = document.querySelector('.hero-image') as HTMLElement;
					if (banner) banner.style.display = ctrlInfoBanner.checked ? 'block' : 'none';
					
					const commentsSection = document.getElementById('comments-section');
					if (commentsSection) {
						commentsSection.style.display = ctrlShowComments.checked ? 'block' : 'none';
					}

					// Update Labels
					if (lblSize) lblSize.innerText = `${ctrlSize.value}px`;
					if (lblHeight) lblHeight.innerText = ctrlHeight.value;
					if (lblWeight) lblWeight.innerText = ctrlWeight.value;

					// Save to localStorage
					localStorage.setItem('reader-font', ctrlFont.value);
					localStorage.setItem('reader-size', ctrlSize.value);
					localStorage.setItem('reader-height', ctrlHeight.value);
					localStorage.setItem('reader-weight', ctrlWeight.value);
					localStorage.setItem('reader-solid-bg', ctrlSolidBg.checked.toString());
					localStorage.setItem('reader-indent', ctrlIndent.checked.toString());
					localStorage.setItem('reader-hyphen', ctrlHyphen.checked.toString());
					localStorage.setItem('reader-sticky-nav', ctrlStickyNav.checked.toString());
					localStorage.setItem('reader-show-nav', ctrlShowNav.checked.toString());
					localStorage.setItem('reader-info-banner', ctrlInfoBanner.checked.toString());
					localStorage.setItem('reader-show-comments', ctrlShowComments.checked.toString());
				};

				const resetSettings = () => {
					ctrlTheme.value = defaults.theme;
					ctrlFont.value = defaults.font;
					ctrlSize.value = defaults.size;
					ctrlHeight.value = defaults.height;
					ctrlWeight.value = defaults.weight;
					ctrlSolidBg.checked = defaults.solidBg === 'true';
					ctrlIndent.checked = defaults.indent === 'true';
					ctrlHyphen.checked = defaults.hyphen === 'true';
					ctrlStickyNav.checked = defaults.stickyNav === 'true';
					ctrlShowNav.checked = defaults.showNav === 'true';
					ctrlInfoBanner.checked = defaults.infoBanner === 'true';
					ctrlShowComments.checked = defaults.showComments === 'true';
					
					alignBtns.forEach(btn => {
						if (btn.getAttribute('data-align') === defaults.align) {
							btn.classList.add('active');
						} else {
							btn.classList.remove('active');
						}
					});
					
					applySettings();
				};

				// Prevent layout shift when locking scroll
				const lockScroll = () => {
					const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
					document.body.style.paddingRight = `${scrollbarWidth}px`;
					document.body.style.overflow = 'hidden';
				};
				const unlockScroll = () => {
					document.body.style.paddingRight = '';
					document.body.style.overflow = '';
				};

				// Event Listeners for Settings Modal
				btnOpen?.addEventListener('click', () => {
					modal?.classList.add('show');
					lockScroll();
				});
				btnClose?.addEventListener('click', () => {
					modal?.classList.remove('show');
					unlockScroll();
				});
				btnReset?.addEventListener('click', resetSettings);
				modal?.addEventListener('click', (e) => {
					if (e.target === modal) {
						modal.classList.remove('show');
						unlockScroll();
					}
				});
				
				// Event Listeners for Contribute Modal
				const contributeModal = document.getElementById('contribute-modal');
				const btnContribute = document.getElementById('btn-contribute');
				const btnCloseContribute = document.getElementById('close-contribute');
				
				btnContribute?.addEventListener('click', () => {
					contributeModal?.classList.add('show');
					lockScroll();
				});
				btnCloseContribute?.addEventListener('click', () => {
					contributeModal?.classList.remove('show');
					unlockScroll();
				});
				contributeModal?.addEventListener('click', (e) => {
					if (e.target === contributeModal) {
						contributeModal.classList.remove('show');
						unlockScroll();
					}
				});
				
				// Event Listeners for TOC Modal
				const tocModal = document.getElementById('toc-modal');
				const btnsToc = document.querySelectorAll('.btn-toc');
				const btnCloseToc = document.getElementById('close-toc');
				
				btnsToc.forEach(btn => {
					btn.addEventListener('click', (e) => {
						e.preventDefault();
						tocModal?.classList.add('show');
						lockScroll();
					});
				});
				btnCloseToc?.addEventListener('click', () => {
					tocModal?.classList.remove('show');
					unlockScroll();
				});
				tocModal?.addEventListener('click', (e) => {
					if (e.target === tocModal) {
						tocModal.classList.remove('show');
						unlockScroll();
					}
				});
				
				// TOC Search Filter
				const tocSearch = document.getElementById('toc-search') as HTMLInputElement;
				const tocItems = document.querySelectorAll('.toc-item');
				tocSearch?.addEventListener('input', (e) => {
					const query = (e.target as HTMLInputElement).value.toLowerCase();
					tocItems.forEach(item => {
						const title = item.getAttribute('data-title') || '';
						if (title.includes(query)) {
							(item as HTMLElement).style.display = 'flex';
						} else {
							(item as HTMLElement).style.display = 'none';
						}
					});
				});
				
				// TOC Order Filter (Asc/Desc)
				const tocOrder = document.getElementById('toc-order');
				const tocListContainer = document.getElementById('toc-list');
				let isTocAsc = true;
				
				tocOrder?.addEventListener('click', () => {
					if (!tocListContainer) return;
					isTocAsc = !isTocAsc;
					const svg = tocOrder.querySelector('svg');
					if (svg) svg.style.transform = isTocAsc ? 'scaleY(1)' : 'scaleY(-1)';
					
					const items = Array.from(tocListContainer.children) as HTMLElement[];
					items.reverse();
					items.forEach(item => tocListContainer.appendChild(item));
				});

				// Listen for input changes in real-time
				[
					ctrlTheme, ctrlFont, ctrlSize, ctrlHeight, ctrlWeight, 
					ctrlSolidBg, ctrlIndent, ctrlHyphen,
					ctrlStickyNav, ctrlShowNav, ctrlInfoBanner, ctrlShowComments
				].forEach(ctrl => {
					if (ctrl) ctrl.addEventListener('input', applySettings);
				});
				
				// Alignment buttons
				alignBtns.forEach(btn => {
					btn.addEventListener('click', () => {
						alignBtns.forEach(b => b.classList.remove('active'));
						btn.classList.add('active');
						localStorage.setItem('reader-align', btn.getAttribute('data-align') || 'left');
						applySettings();
					});
				});
				
				// Fullscreen toggle
				btnFullscreen?.addEventListener('click', () => {
					if (!document.fullscreenElement) {
						document.documentElement.requestFullscreen().catch(() => {});
					} else {
						if (document.exitFullscreen) {
							document.exitFullscreen();
						}
					}
				});
				
				// Restore Nav Button
				btnRestoreNav?.addEventListener('click', () => {
					ctrlShowNav.checked = true;
					applySettings();
				});

				// Initialize Giscus dynamically
				const giscusContainer = document.getElementById('giscus-container');
				if (giscusContainer) {
					const savedTheme = localStorage.getItem('theme') || defaults.theme;
					const giscusTheme = savedTheme === 'dark' ? 'transparent_dark' : 'light';
					
					const script = document.createElement('script');
					script.src = 'https://giscus.app/client.js';
					script.setAttribute('data-repo', 'Shuryaz/Persona_Re_Exist_WebNovel');
					script.setAttribute('data-repo-id', 'R_kgDOU-L6MQ');
					script.setAttribute('data-category', 'General');
					script.setAttribute('data-category-id', 'DIC_kwDOU-L6Mc4DHTTE');
					script.setAttribute('data-mapping', 'pathname');
					script.setAttribute('data-strict', '1');
					script.setAttribute('data-reactions-enabled', '1');
					script.setAttribute('data-emit-metadata', '0');
					script.setAttribute('data-input-position', 'bottom');
					script.setAttribute('data-theme', giscusTheme);
					script.setAttribute('data-lang', 'id');
					script.crossOrigin = 'anonymous';
					script.async = true;
					giscusContainer.appendChild(script);
				}

				// Init
				loadSettings();
			});
		</script>
	</body>
</html>

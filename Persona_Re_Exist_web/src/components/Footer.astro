---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<p>&copy; {today.getFullYear()} Mikazuki Tsuruya. All original writing belongs to the author.</p>
		<p class="disclaimer">
			"Persona" and all related properties are owned by ATLUS and SEGA. <br/>
			This webnovel is a purely non-commercial fan-project created for entertainment purposes only, 
			and is not affiliated with, endorsed by, or sponsored by ATLUS or SEGA.
		</p>
	</div>
</footer>
<style>
	footer {
		padding: 3em 1em;
		background: var(--bg-sepia);
		color: var(--black);
		text-align: center;
		border-top: 1px solid rgba(217, 101, 139, 0.2);
		font-family: var(--font-ui);
	}
	.footer-content {
		max-width: 800px;
		margin: 0 auto;
	}
	footer p {
		margin: 0.5rem 0;
		font-size: 0.9em;
	}
	.disclaimer {
		font-size: 0.75em;
		opacity: 0.7;
		margin-top: 1.5rem !important;
		line-height: 1.5;
	}
</style>

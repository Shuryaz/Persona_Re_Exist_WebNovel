---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('chapters');
	posts.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
	
	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			prev: index > 0 ? posts[index - 1] : null,
			next: index < posts.length - 1 ? posts[index + 1] : null,
		},
	}));
}

type Props = {
	post: CollectionEntry<'chapters'>;
	prev: CollectionEntry<'chapters'> | null;
	next: CollectionEntry<'chapters'> | null;
};

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} id={post.id} prev={prev} next={next}>
	<Content />
</BlogPost>
